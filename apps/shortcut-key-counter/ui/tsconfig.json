{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["ES2020", "DOM"],
    "rootDir": "src",
    "outDir": "dist/js",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
