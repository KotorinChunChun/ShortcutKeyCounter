{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShortcutKeyCounter",
  "version": "0.1.4",
  "identifier": "com.shortcutkeycounter.app",
  "mainBinaryName": "ShortcutKeyCounter",
  "build": {
    "beforeDevCommand": "pwsh -ExecutionPolicy Bypass -File ./scripts/build-ui.ps1",
    "beforeBuildCommand": "pwsh -ExecutionPolicy Bypass -File ./scripts/build-ui.ps1",
    "frontendDist": "ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
